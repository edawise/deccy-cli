#!/bin/sh
# Gate for M-version. Compile the test with the cargo-provided stamp set (plain rustc does
# not define CARGO_PKG_VERSION), then run it.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
CARGO_PKG_VERSION=0.1.0 rustc --test "$here/version.rs" -o "$tmp"
"$tmp"
